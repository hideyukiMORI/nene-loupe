#include "../ui/win32/LoupeIconResource.h"
#include "NeNeLoupeVersion.h"
#include <winver.h>

NENELOUPE_ICON_RESOURCE ICON "NeNeLoupe.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NENELOUPE_VERSION_COMMA
 PRODUCTVERSION NENELOUPE_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NeNe Loupe\0"
            VALUE "FileVersion", NENELOUPE_VERSION_TEXT
            VALUE "InternalName", "NeNeLoupe\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Hideyuki Mori\0"
            VALUE "OriginalFilename", "NeNeLoupe.exe\0"
            VALUE "ProductName", "NeNe Loupe\0"
            VALUE "ProductVersion", NENELOUPE_PRODUCT_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
